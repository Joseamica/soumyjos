# Headers para Cloudflare Pages / Netlify
# El .ics debe servirse con MIME correcto para que iOS/Android lo abran con Calendar
/Soumi-Jos-SaveTheDate.ics
  Content-Type: text/calendar; charset=utf-8
  Content-Disposition: attachment; filename="Soumi-Jos-SaveTheDate.ics"
  Cache-Control: public, max-age=3600

/preview.png
  Cache-Control: public, max-age=86400

/og-preview.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400

# Invitación formal — .ics con su MIME correcto (iOS/Android abren con Calendar)
/Soumi-Jos-Invitacion.ics
  Content-Type: text/calendar; charset=utf-8
  Content-Disposition: attachment; filename="Soumi-Jos-Invitacion.ics"
  Cache-Control: public, max-age=3600

/assets/*.webp
  Cache-Control: public, max-age=604800, immutable

/assets/og-invitacion.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
